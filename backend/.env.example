FLASK_SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite:///gpx_analyzer.db
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
STRAVA_REDIRECT_URI=http://localhost:5000/api/auth/callback
CORS_ORIGINS=http://localhost:3000
UPLOAD_FOLDER=../data/uploads
JWT_SECRET_KEY=your-jwt-secret-key
ENCRYPTION_KEY=

# --- Agent LLM endpoint (optional) ---
# Empty = Anthropic API with ANTHROPIC_API_KEY. For DeepSeek:
# AGENT_BASE_URL=https://api.deepseek.com/anthropic
# OpenRouter: AGENT_BASE_URL=https://openrouter.ai/api, AGENT_MODEL=deepseek/deepseek-v4-flash
# AGENT_API_KEY=           # falls back to ANTHROPIC_API_KEY when empty

# Transactional email for magic-link sign-in (optional).
# Unset: links are written to the app log instead of being sent (dev).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_STARTTLS=1
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@pacemind.app
# AGENT_PROVIDERS=DeepInfra,Novita   # OpenRouter only: pin hosts so the prompt cache hits
