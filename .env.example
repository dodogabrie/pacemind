# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-to-a-random-string
JWT_SECRET_KEY=change-me-to-a-random-string

# Database (leave unset for SQLite in development)
# DATABASE_URL=postgresql://trail:trail@localhost:5432/trail_gpx

# Strava OAuth
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
STRAVA_REDIRECT_URI=http://localhost:5000/api/auth/callback
STRAVA_WEBHOOK_VERIFY_TOKEN=random-hex   # secret in the Strava push callback URL, see api/strava.py webhook

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Encryption key for Strava tokens (auto-generated in dev)
# ENCRYPTION_KEY=base64-fernet-key

# Stripe billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
STRIPE_PRICE_RACE_DAY=price_...
FRONTEND_URL=http://localhost:5173

# Claude AI agent
ANTHROPIC_API_KEY=sk-ant-...

# Monitoring (optional)
# SENTRY_DSN=https://...@sentry.io/...

# Transactional email for magic-link sign-in (optional).
# Unset: links are written to the app log instead of being sent (dev).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_STARTTLS=1
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@pacemind.app
